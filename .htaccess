Options -Indexes
Options +FollowSymLinks
RewriteEngine On

# Serve real files and folders directly (assets, uploads, etc.)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Route everything else through index.php
RewriteRule ^(.*)$ index.php [QSA,L]

# ── Security ──────────────────────────────────────────────────
<FilesMatch "\.(env|sql|log|bak|sh|git|htpasswd|md)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# ── Block direct access to source folders ─────────────────────
# DEPRECATED entry point: this project now targets public/ as the
# real document root (see public/index.php + public/.htaccess),
# which keeps these folders outside the web-servable tree entirely
# and needs no blocklist at all. This rule is a defense-in-depth
# fallback only, in case a server ever gets pointed at the project
# root by mistake.
<IfModule mod_rewrite.c>
    RewriteRule ^(app|admin|frontend|seller-panel|api|config|database|scripts)/ - [F,L]
</IfModule>

# ── PHP settings ──────────────────────────────────────────────
<IfModule mod_php.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 12M
    php_value max_execution_time 60
</IfModule>
