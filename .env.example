# Copy this file to `.env` on your LIVE server and fill in real values.
# On XAMPP, leave this file absent — every setting below has a safe
# local-development default baked into config/*.php already.
#
# NEVER commit the real .env file to version control.

# ── App environment ───────────────────────────────────────────
# development = shows PHP errors on screen (XAMPP default, no .env needed)
# production  = hides errors from visitors, logs them instead (REQUIRED live)
APP_ENV=production

# ── Database ──────────────────────────────────────────────────
# Live hosts (cPanel etc.) usually give you a dedicated DB user —
# don't use root in production.
DB_HOST=localhost
DB_NAME=mycart_marketplace
DB_USER=your_db_user
DB_PASS=your_db_password

# ── Payment gateway (Razorpay) ──────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── SMS (MSG91) ──────────────────────────────────────────────────
MSG91_AUTH_KEY=
MSG91_SENDER_ID=BAZARO

# ── Email (SMTP) ──────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@yourdomain.com

# ── WhatsApp (Meta Cloud API) ─────────────────────────────────────
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
